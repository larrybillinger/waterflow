# Waterflow environment configuration
# Copy to .env and adjust. Never commit the real .env file.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port the optional Node tile-proxy / static server listens on.
# House convention: 8098 production, 8099 development.
APP_PORT=8098

# Where the proxy writes its tile cache inside the container.
TILE_CACHE_DIR=./server/cache

# Maximum tile cache size in megabytes. Oldest entries are evicted first.
TILE_CACHE_MAX_MB=2048

# How long a cached tile stays fresh, in days. Elevation data changes rarely.
TILE_CACHE_TTL_DAYS=90

# ---------------------------------------------------------------------------
# Client data sources
# ---------------------------------------------------------------------------

# Leave blank to have the browser fetch public tiles directly from their origin.
# Set to the proxy path (normally /api/tiles) to route tiles through this server
# instead, which adds disk caching and removes any dependence on third-party
# CORS headers. Recommended for self-hosted deployments.
VITE_TILE_PROXY=

# Default map position the app opens at. Tuttle Creek Lake, Kansas.
VITE_DEFAULT_LAT=39.2447
VITE_DEFAULT_LON=-96.5944

# Default simulation domain edge length in metres.
VITE_DEFAULT_DOMAIN_M=24000

# Default simulation grid edge in cells. Must be a power of two.
VITE_DEFAULT_GRID=512
