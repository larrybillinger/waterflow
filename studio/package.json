{
  "name": "waterflow",
  "version": "0.1.0",
  "description": "Browser-based dam failure flood simulator using public elevation data, a published 2D hydraulic model on the GPU, and a 3D explorable view.",
  "type": "module",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/larrybillinger/waterflow"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host --port 8099",
    "build": "vite build",
    "preview": "vite preview --host --port 8099",
    "serve": "node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src server tests scripts",
    "lint:fix": "eslint src server tests scripts --fix",
    "format": "prettier --write \"**/*.{js,json,css,md,glsl}\"",
    "format:check": "prettier --check \"**/*.{js,json,css,md,glsl}\"",
    "verify": "node scripts/verify-browser.mjs",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "express": "^4.21.2",
    "globals": "^15.0.0",
    "prettier": "^3.3.0",
    "puppeteer-core": "^25.18.1",
    "vite": "^8.0.0",
    "vite-plugin-glsl": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
